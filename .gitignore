# ─────────────────────────────────────────────────────────────
#  SPECTER — .gitignore
#  Project root: C:\Users\h\Documents\Project_SPECTER\
# ─────────────────────────────────────────────────────────────


# ── Dataset (too large to commit — 19 GB) ─────────────────────
**/*.hdf5
**/*.h5
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tar.bz2


# ── Model checkpoints (generated by train.py) ─────────────────
specter/results/*.pt


# ── Pickle files (except the open-set threshold) ──────────────
**/*.pkl
!specter/results/open_set_threshold.pkl


# ── Keep all benchmark outputs in results/ ────────────────────
# (results/ is tracked so judges can see outputs without training)
!specter/results/.gitkeep
!specter/results/accuracy_vs_snr.csv
!specter/results/accuracy_vs_snr.png
!specter/results/confusion_baseline.png
!specter/results/confusion_specter.png
!specter/results/open_set_auroc.png
!specter/results/open_set_threshold.pkl


# ── Keep raw data folder structure (not the data itself) ──────
specter/data/raw/radio_ML/
!specter/data/raw/.gitkeep


# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
*.egg


# ── Virtual environments ───────────────────────────────────────
venv/
env/
.env
.env.*
*.venv


# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb


# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db


# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~


# ── Temp / logs ───────────────────────────────────────────────
*.tmp
*.log
*.log.*
logs/
wandb/
runs/
lightning_logs/


# ── Misc large binary artifacts ───────────────────────────────
*.bin
*.pt.bak
*.onnx
